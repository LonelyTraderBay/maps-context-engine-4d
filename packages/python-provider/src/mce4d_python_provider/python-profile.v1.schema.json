{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maps-context-engine-4d.invalid/contracts/python-profile.v1.schema.json",
  "title": "MCE4D Python effective profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "python_implementation",
    "python_version",
    "python_executable_digest",
    "provider_digest",
    "module_roots",
    "analysis_mode",
    "allow_project_plugins"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "language": { "const": "python" },
    "python_implementation": { "const": "CPython" },
    "python_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "python_executable_digest": { "$ref": "#/$defs/hash" },
    "provider_digest": { "$ref": "#/$defs/hash" },
    "module_roots": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "analysis_mode": { "enum": ["syntax", "typed_when_available"] },
    "allow_project_plugins": { "const": false }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\\\)(?!.*:).+$"
    }
  }
}
